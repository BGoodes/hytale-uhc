$C = "../../Common.ui";

@FieldLabelStyle = (...$C.@DefaultLabelStyle, VerticalAlignment: Center);

Group {
  LayoutMode: Left;
  Anchor: (Bottom: 8);

  Label #Label {
    Anchor: (Left: 6, Width: 90);
    Style: (...@FieldLabelStyle, RenderBold: true);
  }

  Label #TimeLabel {
    Anchor: (Width: 80);
    Style: @FieldLabelStyle;
  }

  $C.@TextField #Time {
    @Anchor = (Width: 90, Right: 16);
  }

  Label #RadiusLabel {
    Anchor: (Width: 60);
    Style: @FieldLabelStyle;
  }

  $C.@TextField #Radius {
    @Anchor = (Width: 90, Right: 16);
  }

  Label #SpeedLabel {
    Anchor: (Width: 80);
    Style: @FieldLabelStyle;
  }

  $C.@TextField #Speed {
    @Anchor = (Width: 90, Right: 16);
  }

  $C.@SmallSecondaryTextButton #RemoveButton {
  }
}
