# === host ===

host.claim.success = Vous êtes désormais l'hôte de la partie.
host.claim.failure = Il y a déjà un host dans la partie.
host.start.failure = La partie est déjà lancée.

# === connection ===

connection.denied.host = Cette partie n'a pas encore d'host.
connection.denied.started = La partie a déjà commencé !

# === game ===

game.started.chat = Début de la partie !!!
