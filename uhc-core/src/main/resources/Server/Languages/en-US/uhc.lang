game.pvp.countdown.hud = Début PVP : {time}

# === border ===

game.border.shrinking.chat = La bordure se réduit jusqu'à {radius} blocs.
game.border.shrunk.chat = La bordure a atteint {radius} blocs.
game.border.shrinking.title = La bordure rétrécit !
