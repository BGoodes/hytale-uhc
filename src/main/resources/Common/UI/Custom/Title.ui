Group #TitleRoot {
    Anchor: (Top: 400, Width: 800, Height: 120);
    LayoutMode: Top;
    Visible: false;

    Label #PrimaryLabel {
        Anchor: (Height: 70);
        Style: (
            FontSize: 56,
            TextColor: #ffffff,
            HorizontalAlignment: Center,
            VerticalAlignment: Center,
            RenderBold: true
        );
        Text: "";
    }

    Label #SecondaryLabel {
        Anchor: (Height: 36);
        Style: (
            FontSize: 24,
            TextColor: #ffffff(0.75),
            HorizontalAlignment: Center,
            VerticalAlignment: Center
        );
        Text: "";
    }
}
